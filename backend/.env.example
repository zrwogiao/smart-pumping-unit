# 应用配置
APP_NAME=智能抽油机系统
APP_VERSION=1.0.0
DEBUG=true

# 数据库 (SQLite，相对 backend 目录)
DATABASE_URL=sqlite:///./data/pump.db

# 安全
SECRET_KEY=smart-pump-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 模拟引擎
SIMULATION_INTERVAL_SECONDS=3
DEFAULT_DEVICE_ID=1

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
